# Copy to .env.local for local development (never commit the real file).
# What each value is and where to get it: docs/DEPLOY-HOSTINGER.md#environment-variables-secrets-and-settings

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=PHP
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# NEXT_PUBLIC_GOOGLE_SIGNIN=on

# AI menu import (Phase 4)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# App emails, e.g. "account restored" (OTC-18). Set ONE of these.
RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=OneTableCircle <no-reply@onetablecircle.com>
